<% title "probe-d9c337 — sign the wall" %>

<section class="gb" aria-labelledby="gb-title">
  <div class="gb__inner">
    <header class="gb__head">
      <p class="gb__eyebrow">probe-d9c337</p>
      <h1 id="gb-title" class="gb__title">Leave a note on the wall</h1>
      <p class="gb__lede">A one-page guestbook. Say hi — it shows up at the top, newest first.</p>
    </header>

    <div class="gb__grid">
      <%= form_with model: @message, url: messages_path, class: "gb__form md-card md-card--elevated", aria: { label: "Post a message" } do |form| %>
        <h2 class="gb__form-title">Sign it</h2>
        <%= md_text_field(form, :author_name, label: "Name", hint: "Optional — otherwise it reads “anonymous”.") %>
        <%= md_text_field(form, :body, label: "Message", type: :textarea, hint: "Up to 500 characters.") %>
        <div class="gb__actions">
          <%= md_button "Post to the wall", type: "submit", variant: :filled, icon: :send %>
        </div>
      <% end %>

      <div class="gb__wall">
        <div class="gb__wall-head">
          <h2 class="gb__wall-title">The wall</h2>
          <span class="gb__count"><%= pluralize @messages.size, "note" %></span>
        </div>

        <% if @messages.empty? %>
          <p class="gb__empty">Nothing here yet — be the first to sign.</p>
        <% else %>
          <ol class="gb__list">
            <% @messages.each do |message| %>
              <li class="gb__note">
                <p class="gb__note-body"><%= message.body %></p>
                <p class="gb__note-meta">
                  <span class="gb__note-author"><%= material_symbol(:person, size: 20) %><%= message.author_name.presence || "anonymous" %></span>
                  <time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%-d %b %Y · %H:%M") %></time>
                </p>
              </li>
            <% end %>
          </ol>
        <% end %>
      </div>
    </div>
  </div>
</section>
